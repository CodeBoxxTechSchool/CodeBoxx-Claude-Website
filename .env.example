VITE_SANITY_PROJECT_ID=
VITE_SANITY_DATASET=production
VITE_SANITY_API_VERSION=2024-01-01
VITE_SANITY_TOKEN=
# PUBLIC_ vars are the same project/dataset, just under the prefix Astro
# actually inlines into browser-bundled code (see the comment atop
# src/lib/sanity.js) — keep these two sets in sync, and never add a
# PUBLIC_SANITY_TOKEN (would ship a write-capable token to the browser).
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production
PUBLIC_SANITY_API_VERSION=2024-01-01
# Academy start dates (src/lib/cohorts.js, readme.md "Academy start dates"): the relay's
# /api/cohorts by default; COHORTS_FILE reads a local JSON file of the same shape instead.
# COHORTS_URL=https://codeboxx.ai/api/cohorts
# COHORTS_FILE=
