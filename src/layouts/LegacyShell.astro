---
// Shell for the not-yet-migrated pages (Home, Financing, Ventures, and the 404
// fallback — see each src/pages/*.astro file that renders this). Head markup is
// copied verbatim from the old index.html: the same static fallback tags
// (data-rh="true") that react-helmet-async's client-side Seo.jsx has always
// relied on to find-and-replace on mount, so behavior for these routes is
// unchanged from production today. Once a page here gets natively ported to
// Astro (same treatment Blog/BlogPost already got), it moves to Layout.astro
// instead and this file's per-page usage shrinks by one.
import '../styles/main.scss';
import LegacyAppIsland from '../components/LegacyAppIsland';

const organizationSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'CodeBoxx',
  url: 'https://codeboxx.com/',
  description:
    'CodeBoxx builds AI-native software and teams, trains developers through CodeBoxx Academy, and launches ventures with CrewKit.',
  logo: 'https://codeboxx.com/favicon.svg',
});
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>CodeBoxx — AI-First, Human-Built</title>
    <meta
      data-rh="true"
      name="description"
      content="CodeBoxx builds AI-native software and teams, trains developers through CodeBoxx Academy, and launches ventures with CrewKit — AI-first, human-built."
    />
    <meta data-rh="true" name="robots" content="index, follow" />
    <link data-rh="true" rel="canonical" href="https://codeboxx.com/" />
    <link data-rh="true" rel="alternate" hreflang="en" href="https://codeboxx.com/" />
    <link data-rh="true" rel="alternate" hreflang="fr" href="https://codeboxx.com/fr" />
    <link data-rh="true" rel="alternate" hreflang="x-default" href="https://codeboxx.com/" />

    <meta data-rh="true" property="og:site_name" content="CodeBoxx" />
    <meta data-rh="true" property="og:type" content="website" />
    <meta data-rh="true" property="og:url" content="https://codeboxx.com/" />
    <meta data-rh="true" property="og:title" content="CodeBoxx — AI-First, Human-Built" />
    <meta
      data-rh="true"
      property="og:description"
      content="CodeBoxx builds AI-native software and teams, trains developers through CodeBoxx Academy, and launches ventures with CrewKit — AI-first, human-built."
    />
    <meta data-rh="true" property="og:image" content="https://codeboxx.com/assets/hero-bg.png" />
    <meta data-rh="true" property="og:locale" content="en_US" />
    <meta data-rh="true" property="og:locale:alternate" content="fr_CA" />

    <meta data-rh="true" name="twitter:card" content="summary_large_image" />
    <meta data-rh="true" name="twitter:title" content="CodeBoxx — AI-First, Human-Built" />
    <meta
      data-rh="true"
      name="twitter:description"
      content="CodeBoxx builds AI-native software and teams, trains developers through CodeBoxx Academy, and launches ventures with CrewKit — AI-first, human-built."
    />
    <meta data-rh="true" name="twitter:image" content="https://codeboxx.com/assets/hero-bg.png" />

    <meta name="theme-color" content="#002f43" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;900&family=Great+Vibes&display=swap"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;900&family=Great+Vibes&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;900&family=Great+Vibes&display=swap"
        rel="stylesheet"
      />
    </noscript>

    <script type="application/ld+json" set:html={organizationSchema}></script>
  </head>
  <body>
    <div id="root">
      <LegacyAppIsland client:only="react" />
    </div>
  </body>
</html>
