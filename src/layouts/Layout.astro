---
// Shell for natively-migrated pages whose TopBar/Footer have no state to share
// with the page content (currently: /blog and /blog/:slug, EN and FR) — mounted as
// two independent islands. Home needs a different shell (see HomeIsland.jsx) since
// its TopBar's Codi/Enroll buttons must share state with content deep in the page;
// both shells render the same SeoHead.astro, so both get real, build-time SEO tags.
import '../styles/main.scss';
import SeoHead from './SeoHead.astro';
import ScrollReveal from '../components/ScrollReveal.astro';
import DeferredVideos from '../components/DeferredVideos.astro';
import { TopBar, Footer, LicensureNotice } from '../components/ChromeIsland';

const {
  lang,
  title,
  description,
  image,
  type,
  noindex,
  structuredData,
  // SeoHead: false when the page has no twin in the other language (no hreflang pair), and
  // the canonical URL when it isn't the page itself (a blog post's untranslated French copy).
  translated,
  canonicalUrl,
  strings, // current-language common.js content (nav/actions/footer), for ChromeIsland
  hideTopBar = false,
  hideFooter = false,
  // Overrides TopBar's computed language-toggle target — needed by pages whose
  // path isn't in i18nRoutes.js's ROUTE_TABLE (e.g. a landingPage document,
  // whose EN/FR slugs are per-document and unrelated to each other).
  langHref,
  // The page mounts Codi (CodiChat.jsx): TopBar's "Talk With Codi" opens it.
  codi = false,
  // TopBar's call to action, by audience: 'enroll' (the Academy application, on the Academy's
  // pages), 'contact' (the page's own #contact section: inquire or pitch, for companies) or
  // 'general' (Contact Us, the homepage's contact form).
  cta = 'general',
} = Astro.props;

const pathname = Astro.url.pathname;
---

<html lang={lang}>
  <head>
    <SeoHead
      lang={lang}
      title={title}
      description={description}
      image={image}
      type={type}
      noindex={noindex}
      structuredData={structuredData}
      translated={translated}
      canonicalUrl={canonicalUrl}
    />
  </head>
  <body>
    <div id="top">
      {!hideTopBar && (
        <TopBar
          client:load
          lang={lang}
          pathname={pathname}
          strings={strings}
          langHref={langHref}
          codi={codi}
          cta={cta}
        />
      )}
      <main id="main" tabindex="-1">
        <slot />
      </main>
      {!hideFooter && <Footer client:load lang={lang} pathname={pathname} strings={strings} />}
      {hideFooter && (
        <LicensureNotice lang={lang} strings={strings} className="licensure-standalone" />
      )}
    </div>
    <ScrollReveal />
    <DeferredVideos />
  </body>
</html>
