---
// FR twin of src/pages/crewkit-forge-20/dive-deeper.astro.
import Layout from '../../../layouts/Layout.astro';
import BusinessContactSection from '../../../components/BusinessContactSection.astro';
import ForgeDeep from '../../../components/ForgeDeep.astro';
import { localizedHref } from '../../../lib/i18nRoutes';
import common from '../../../locales/fr/common';
import forge from '../../../locales/fr/forge';
import deep from '../../../locales/fr/forgeDeep';

const pathname = Astro.url.pathname;
---

<Layout
  lang="fr"
  title={deep.seo.title}
  description={deep.seo.description}
  image="https://codeboxx.ai/assets/crewkit-forge-poster.webp"
  strings={common}
  cta="contact"
>
  <ForgeDeep
    t={deep}
    lang="fr"
    forgeHref={localizedHref('/crewkit-forge-20', 'fr', pathname)}
    buildOrderUrl={forge.buildOrderUrl}
  />
  <BusinessContactSection lang="fr" topic="factory" />
</Layout>
