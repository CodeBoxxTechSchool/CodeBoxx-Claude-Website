---
// Natively-migrated /financing (EN), content from academy.codeboxx.com's financing
// page. See src/pages/fr/financement.astro for the FR twin. No React island beyond
// the shared TopBar/Footer from Layout.astro — every button here just navigates.
import Layout from '../layouts/Layout.astro';
import HeroVideo from '../components/HeroVideo.astro';
import RichParagraph from '../components/RichParagraph.astro';
import { localizedHref } from '../lib/i18nRoutes';
import common from '../locales/en/common';
import financing from '../locales/en/financing';

const pathname = Astro.url.pathname;
---

<Layout
  lang="en"
  title={financing.seo.title}
  description={financing.seo.description}
  strings={common}
>
  <section class="band-dark">
    <HeroVideo />
    <div class="wrap d-flex flex-column gap-4 align-items-start">
      <span class="pill">{financing.pill}</span>
      <h1 class="band-title">{financing.band.title}</h1>
      <p class="band-lede">{financing.band.lede}</p>
      <a class="btn btn-primary" href={financing.schedule.href} target="_blank" rel="noopener">
        {financing.schedule.label}
      </a>
    </div>
  </section>

  <section class="sect">
    <div class="wrap d-flex flex-column gap-5">
      <div class="d-flex flex-column gap-3">
        <p class="eyebrow">{financing.paths.eyebrow}</p>
        <h2 class="h2">{financing.paths.title}</h2>
        <p class="lede lede-640">{financing.paths.lede}</p>
      </div>
      <div class="grid2">
        {financing.paths.items.map(({ title, subtitle, body, bullets, cta, note }) => (
          <div class="panel">
            <div class="panel-header-row">
              <h3 class="ptitle">{title}</h3>
              <span class="badge bg-brand">{financing.academyBadge}</span>
            </div>
            <p class="panel-subtitle">{subtitle}</p>
            {body.map((p) => (
              <RichParagraph p={p} lang="en" />
            ))}
            {bullets && (
              <>
                <div class="rule" />
                <div class="bullet-list">
                  {bullets.map((b) => (
                    <div class="bullet">
                      <span>{b}</span>
                    </div>
                  ))}
                </div>
              </>
            )}
            {cta && (
              <a
                class="btn btn-outline-primary align-self-start"
                href={cta.href}
                target="_blank"
                rel="noopener"
              >
                {cta.label}
              </a>
            )}
            {note && <RichParagraph p={note} lang="en" class="panel-note" />}
          </div>
        ))}
      </div>
      <RichParagraph p={financing.pinellas} lang="en" class="lede panel-callout" />
    </div>
  </section>

  <section class="sect sect-navy">
    <div class="wrap band-dark-left">
      <p class="eyebrow eyebrow-brand">{financing.riskFree.eyebrow}</p>
      <h2 class="h2 h2-inverse">{financing.riskFree.title}</h2>
      {financing.riskFree.body.map((p) => (
        <p class="band-body">{p}</p>
      ))}
    </div>
  </section>

  <section class="sect">
    <div class="wrap d-flex flex-column gap-3">
      <p class="eyebrow">{financing.beyond.eyebrow}</p>
      <h2 class="h2">{financing.beyond.title}</h2>
      <div class="d-flex flex-column gap-3 lede-640">
        {financing.beyond.body.map((p) => (
          <RichParagraph p={p} lang="en" />
        ))}
      </div>
    </div>
  </section>

  <section class="sect sect-contact">
    <div class="wrap grid2">
      <div class="d-flex flex-column gap-3">
        <p class="eyebrow">{financing.ask.eyebrow}</p>
        <h2 class="h2">{financing.ask.title}</h2>
        <p class="lede">{financing.ask.lede}</p>
        <div class="d-flex gap-3 flex-wrap">
          <a class="btn btn-primary" href={financing.schedule.href} target="_blank" rel="noopener">
            {financing.ask.schedule}
          </a>
        </div>
      </div>
      <div class="panel align-self-start">
        <h3 class="ptitle">{financing.ask.investTitle}</h3>
        <a
          class="btn btn-outline-primary align-self-start"
          href={localizedHref('#academy-courses', 'en', pathname)}
        >
          {financing.ask.enroll}
        </a>
      </div>
    </div>
  </section>
</Layout>
