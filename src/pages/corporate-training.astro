---
// /corporate-training: CodeBoxx for Businesses, its own SKU (FR twin:
// /fr/formation-entreprise). academy.codeboxx.com/corporate-training and
// /technology-training-for-businesses 301 here. Body:
// src/components/CorporateTraining.astro; content: src/locales/en/corporate.js.
import Layout from '../layouts/Layout.astro';
import CorporateTraining from '../components/CorporateTraining.astro';
import common from '../locales/en/common';
import corporate from '../locales/en/corporate';
import { serviceSchema } from '../lib/schemaOrg';

// Corporate training as Service structured data, with its engagement formats as the offers.
const trainingSchema = serviceSchema({
  name: corporate.seo.title.split(' | ')[0],
  description: corporate.seo.description,
  url: 'https://codeboxx.ai/corporate-training/',
  offers: corporate.formats.items.map((f) => ({ name: f.name, description: f.body })),
});
---

<Layout
  lang="en"
  title={corporate.seo.title}
  description={corporate.seo.description}
  strings={common}
  structuredData={trainingSchema}
  cta="contact"
>
  <CorporateTraining t={corporate} lang="en" />
</Layout>
