---
// Natively-migrated / (EN). See src/pages/fr/index.astro for the FR twin, and
// HomeIsland.jsx for why this mounts one big island instead of Blog's
// many-small-islands approach. studioTeam/academyTeam/logos are fetched at build
// time (like Blog's posts) and passed in already-resolved; the intake calendar is
// the one exception — HomeIsland.jsx explains why it still fetches client-side.
import SeoHead from '../layouts/SeoHead.astro';
import ScrollReveal from '../components/ScrollReveal.astro';
import DeferredVideos from '../components/DeferredVideos.astro';
import HomeIsland from '../components/HomeIsland';
import {
  fetchTeam,
  fetchLogos,
  fetchPostList,
  fetchClientTestimonials,
  fetchGraduateTestimonials,
  toPostCard,
} from '../lib/sanityContent';
import { LATEST_POSTS } from '../lib/homeSeed';
import '../styles/main.scss';
import common from '../locales/en/common';
import home from '../locales/en/home';

const pathname = Astro.url.pathname;
const [studioTeam, academyTeam, logos, latestPosts, clientTestimonials, graduateTestimonials] =
  await Promise.all([
    fetchTeam('studio'),
    fetchTeam('academy'),
    fetchLogos(),
    fetchPostList(LATEST_POSTS),
    fetchClientTestimonials(),
    fetchGraduateTestimonials(),
  ]);
---

<html lang="en">
  <head>
    <SeoHead lang="en" title={home.seo.title} description={home.seo.description} />
    <!-- The hero's CSS background is the mobile LCP element; without this the
         browser only discovers it after downloading and parsing the stylesheet. -->
    <link rel="preload" as="image" href="/assets/hero-bg.webp" fetchpriority="high" />
  </head>
  <body>
    <HomeIsland
      client:load
      lang="en"
      pathname={pathname}
      home={home}
      common={common}
      studioTeam={studioTeam}
      academyTeam={academyTeam}
      logos={logos}
      latestPosts={latestPosts.slice(0, 3).map(toPostCard)}
      clientTestimonials={clientTestimonials}
      graduateTestimonials={graduateTestimonials}
    />
    <ScrollReveal />
    <DeferredVideos />
  </body>
</html>
