---
// /crewkit-forge-20 — landing page for the CodeBoxx w/ CrewKit Forge 20 appliance.
// Same path as the retired Wix page (www.codeboxx.com/crewkit-forge-20), so the
// legacy URL maps one-to-one. Body lives in ForgeLanding.astro, shared with the FR
// twin at src/pages/fr/crewkit-forge-20.astro. Home's Forge band "Learn More"
// button links here.
import Layout from '../layouts/Layout.astro';
import BusinessContactSection from '../components/BusinessContactSection.astro';
import ForgeLanding from '../components/ForgeLanding.astro';
import { localizedHref } from '../lib/i18nRoutes';
import common from '../locales/en/common';
import forge from '../locales/en/forge';

const pathname = Astro.url.pathname;
---

<Layout
  lang="en"
  title={forge.seo.title}
  description={forge.seo.description}
  image="https://codeboxx.ai/assets/crewkit-forge-poster.webp"
  strings={common}
  cta="contact"
>
  <ForgeLanding
    t={forge}
    contactHref="#contact"
    deepHref={localizedHref('/crewkit-forge-20/dive-deeper', 'en', pathname)}
  />
  <BusinessContactSection lang="en" topic="factory" />
</Layout>
