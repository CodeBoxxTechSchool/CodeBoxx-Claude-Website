---
// Isometric, to-scale line drawing of the CodeBoxx w/ CrewKit Forge 20 for the
// /crewkit-forge-20 landing page: a 1 m chamfered cube (90 mm facets, 32" wall
// screens on its faces) on the 1,300 x 1,160 x 372 mm PowerCore Table, with the
// two-screen console wedge on top. Geometry comes from the Rev K dimensions and was
// generated once by a small projection script (isometric, 190 px per metre), so
// the proportions are real, not eyeballed. Pure SVG, zero JS. Callout labels are
// passed in so the EN and FR pages share one drawing.
const { labels, title } = Astro.props;
---

<svg
  class="forge-cube"
  viewBox="0 -20 760 560"
  role="img"
  aria-labelledby="forge-cube-title"
  xmlns="http://www.w3.org/2000/svg"
>
  <title id="forge-cube-title">{title}</title>
  <g class="fx-body">
    <polygon class="fx-side-l" points="97.6,329.7 311.5,453.2 311.5,523.9 97.6,400.4" />
    <polygon class="fx-side-r" points="502.4,343.0 311.5,453.2 311.5,523.9 502.4,413.6" />
    <polygon class="fx-top" points="288.5,219.5 502.4,343.0 311.5,453.2 97.6,329.7" />
    <polygon class="fx-glow" points="97.6,339.2 311.5,462.7 311.5,466.5 97.6,343.0" />
    <polygon class="fx-glow" points="502.4,352.5 311.5,462.7 311.5,466.5 502.4,356.3" />
    <polygon class="fx-side-l" points="150.3,154.9 285.2,232.8 285.2,422.8 150.3,344.9" />
    <polygon class="fx-chamfer" points="285.2,232.8 314.8,232.8 314.8,422.8 285.2,422.8" />
    <polygon class="fx-side-r" points="449.7,154.9 314.8,232.8 314.8,422.8 449.7,344.9" />
    <polygon class="fx-chamfer" points="150.3,154.9 150.3,137.8 150.3,327.8 150.3,344.9" />
    <polygon class="fx-chamfer" points="449.7,154.9 449.7,137.8 449.7,327.8 449.7,344.9" />
    <polygon
      class="fx-top"
      points="314.8,59.9 449.7,137.8 449.7,154.9 314.8,232.8 285.2,232.8 150.3,154.9 150.3,137.8 285.2,59.9"
    />
    <polygon class="fx-screen" points="159.1,212.9 276.3,280.6 276.3,357.1 159.1,289.4" />
    <polygon class="fx-screen" points="440.9,212.9 323.7,280.6 323.7,357.1 440.9,289.4" />
    <polygon class="fx-side-r" points="312.8,193.3 353.0,123.7 381.4,50.6 389.6,49.6 389.6,148.9" />
    <polygon class="fx-screen fx-screen-top" points="218.7,138.9 312.8,193.3 353.0,123.7 258.9,69.4" />
    <polygon class="fx-screen fx-screen-top" points="258.9,69.4 353.0,123.7 381.4,50.6 287.2,-3.8" />
    <polygon class="fx-top" points="287.2,-3.8 381.4,50.6 389.6,49.6 295.5,-4.7" />
    <circle class="fx-caster" cx="107.5" cy="412.1" r="7" />
    <circle class="fx-caster" cx="311.5" cy="529.9" r="7" />
    <circle class="fx-caster" cx="492.5" cy="425.4" r="7" />
  </g>

  <g class="fx-dim" aria-hidden="true">
    <line x1="118" y1="155" x2="118" y2="345" />
    <line x1="110" y1="155" x2="126" y2="155" />
    <line x1="110" y1="345" x2="126" y2="345" />
    <text x="100" y="254" text-anchor="end">
      1 m
    </text>
  </g>

  <g class="fx-callouts">
    <polyline points="286,131 420,70 540,70" />
    <circle cx="286" cy="131" r="4" />
    <text x="548" y="66" class="fx-label">
      {labels.console}
    </text>
    <text x="548" y="86" class="fx-sub">
      {labels.consoleSub}
    </text>

    <polyline points="383,285 460,250 540,250" />
    <circle cx="383" cy="285" r="4" />
    <text x="548" y="246" class="fx-label">
      {labels.cube}
    </text>
    <text x="548" y="266" class="fx-sub">
      {labels.cubeSub}
    </text>

    <polyline points="407,433 470,440 540,440" />
    <circle cx="407" cy="433" r="4" />
    <text x="548" y="436" class="fx-label">
      {labels.table}
    </text>
    <text x="548" y="456" class="fx-sub">
      {labels.tableSub}
    </text>
  </g>
</svg>
