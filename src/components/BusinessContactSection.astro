---
// The #contact section of every page for companies (Layout cta="contact": Solutions, Case
// Studies, Corporate Training, Forge 20, Ventures, #AIDoneRight, EN and FR). Academy visitors
// enroll; Solutions visitors inquire and pitch: the business form (BusinessContact.jsx) for an
// inquiry, and the Ventures pitch drawer (PitchWidget.jsx) for a venture. The header's "Contact
// Us" and the pages' buttons link here; a link with data-contact-topic="<value>" also picks the
// form's topic. `topic`: the page's default (e.g. training on Corporate Training).
import BusinessContact from './BusinessContact';
import PitchWidget from './PitchWidget';
import businessEn from '../locales/en/businessContact';
import businessFr from '../locales/fr/businessContact';
import homeEn from '../locales/en/home';
import homeFr from '../locales/fr/home';
import venturesEn from '../locales/en/ventures';
import venturesFr from '../locales/fr/ventures';
import commonEn from '../locales/en/common';
import commonFr from '../locales/fr/common';

const { lang, topic = 'project' } = Astro.props;
const fr = lang === 'fr';
const t = fr ? businessFr : businessEn;
const home = fr ? homeFr : homeEn;
const ventures = fr ? venturesFr : venturesEn;
const common = fr ? commonFr : commonEn;
---

<section id="contact" class="sect biz-contact">
  <div class="wrap biz-contact-grid">
    <div class="biz-contact-intro">
      <p class="eyebrow eyebrow-brand">{t.eyebrow}</p>
      <h2 class="biz-contact-title">{t.title}</h2>
      <p class="lede">{t.lede}</p>
      <ul class="biz-contact-list">
        {t.topics.map((x) => (
          <li>
            <a href="#contact" data-contact-topic={x.value}>
              <span class="biz-contact-list-label">{x.label}</span>
              <span class="biz-contact-list-hint">{x.hint}</span>
            </a>
          </li>
        ))}
      </ul>
      <div class="biz-autonomy">
        <h3 class="biz-autonomy-title">{t.autonomy.title}</h3>
        <p>{t.autonomy.body}</p>
      </div>
      <div class="biz-pitch">
        <h3 class="biz-pitch-title">{t.pitch.title}</h3>
        <p>{t.pitch.body}</p>
        <div>
          {/* idle, not visible: the drawer must answer the first click, even right after load. */}
          <PitchWidget
            client:idle
            ventures={ventures}
            lang={lang}
            closeLabel={common.actions.close}
          />
        </div>
      </div>
    </div>
    <BusinessContact client:visible t={t} home={home} lang={lang} defaultTopic={topic} />
  </div>
</section>

<script>
  // TOPIC_EVENT in BusinessContact.jsx. The choice is also kept on window for the island, which
  // may hydrate only once the form scrolls into view.
  document.addEventListener('click', (e) => {
    const link = e.target.closest?.('[data-contact-topic]');
    if (!link) return;
    const topic = link.getAttribute('data-contact-topic');
    window.__cbxContactTopic = topic;
    window.dispatchEvent(new CustomEvent('contact:topic', { detail: topic }));
  });
</script>
