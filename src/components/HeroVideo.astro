---
// Looping background video + scrim for a page's hero/intro band — drop as the
// first two children of a `.hero` or `.band-dark` element (both already have
// the CSS to position/stack these, see _components.scss). WebM first since it's
// ~30% smaller than the H.264 fallback at comparable quality; browsers that
// can't decode WebM skip to the .mp4 source automatically. Hidden below the
// tablet breakpoint and under prefers-reduced-motion (see _components.scss) —
// the parent's own static background-image/color covers that case, so there's
// no separate <img> fallback needed here.
---

<video
  class="hero-video"
  autoplay
  muted
  loop
  playsinline
  preload="none"
  poster="/assets/hero-video-poster.webp"
  aria-hidden="true"
>
  <source src="/assets/hero-video-bkg.webm" type="video/webm" />
  <source src="/assets/hero-video-bkg.mp4" type="video/mp4" />
</video>
<div class="hero-video-scrim" aria-hidden="true"></div>
