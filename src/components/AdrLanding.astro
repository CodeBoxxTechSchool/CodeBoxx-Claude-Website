---
// Body of the #AIDoneRight standard page, shared by src/pages/ai-done-right.astro
// (EN) and src/pages/fr/ai-done-right.astro (FR). Written for journalists and for
// readers who fear or distrust AI: plain language first, the standard's wording
// quoted where it matters, and the full PDF one click away at every step. One
// island (AdrExplorer) for the concern/Article explorer; everything else is static.
// Styles in src/styles/_adr.scss.
import AdrExplorer from './AdrExplorer';

const { t, pageUrl } = Astro.props;
const dl = { href: t.pdf.href, download: t.pdf.file };
const share = {
  linkedin: 'https://www.linkedin.com/sharing/share-offsite/?url=' + encodeURIComponent(pageUrl),
  x:
    'https://twitter.com/intent/tweet?text=' +
    encodeURIComponent(t.cta.shareText) +
    '&url=' +
    encodeURIComponent(pageUrl),
  facebook: 'https://www.facebook.com/sharer/sharer.php?u=' + encodeURIComponent(pageUrl),
};
---

<section class="adr-hero">
  <div class="wrap adr-hero-inner">
    <p class="adr-hero-tag">{t.hero.tag}</p>
    <h1 class="adr-hero-title">{t.hero.title}</h1>
    <p class="adr-hero-lede">{t.hero.lede}</p>
    <div class="adr-actions">
      <a class="btn btn-primary btn-lg" {...dl}>
        {t.hero.download}
      </a>
      <a class="btn btn-outline-light btn-lg" href="#standard">
        {t.hero.explore}
      </a>
    </div>
    <p class="adr-hero-meta">
      <span>{t.pdf.meta}</span>
      <span>{t.hero.status}</span>
    </p>
  </div>
</section>

<section class="sect adr-worry">
  <div class="wrap adr-worry-grid">
    <div class="d-flex flex-column gap-3">
      <p class="eyebrow">{t.worry.eyebrow}</p>
      <h2 class="h2 adr-h2">{t.worry.title}</h2>
      <p class="lede">{t.worry.body}</p>
    </div>
    <div class="d-flex flex-column gap-3">
      <dl class="adr-stats">
        {t.worry.stats.map(([value, text, source]) => (
          <div class="adr-stat">
            <dt class="adr-stat-value">{value}</dt>
            <dd>
              <span class="adr-stat-text">{text}</span>
              <span class="adr-stat-source">{source}</span>
            </dd>
          </div>
        ))}
      </dl>
      <p class="adr-footnote">{t.worry.source}</p>
    </div>
  </div>
</section>

<section class="adr-idea">
  <div class="wrap adr-idea-inner">
    <p class="eyebrow adr-eyebrow-gold">{t.idea.eyebrow}</p>
    <blockquote class="adr-idea-quote">{t.idea.quote}</blockquote>
    <div class="adr-idea-body">
      {t.idea.body.map((p) => (
        <p>{p}</p>
      ))}
    </div>
  </div>
</section>

<section class="sect adr-standard" id="standard">
  <div class="wrap d-flex flex-column gap-4">
    <div class="d-flex flex-column gap-3">
      <p class="eyebrow">{t.fears.eyebrow}</p>
      <h2 class="h2 adr-h2">{t.fears.title}</h2>
      <p class="lede lede-640">{t.fears.lede}</p>
    </div>
    <AdrExplorer client:visible t={t} />
  </div>
</section>

<section class="sect adr-pledge">
  <div class="wrap adr-pledge-grid">
    <div class="d-flex flex-column gap-3">
      <p class="eyebrow adr-eyebrow-gold">{t.pledge.eyebrow}</p>
      <h2 class="h2 h2-inverse adr-h2">{t.pledge.title}</h2>
      <p class="adr-pledge-close">{t.pledge.close}</p>
    </div>
    <ol class="adr-pledge-list">
      {t.pledge.lines.map((line) => (
        <li>{line}</li>
      ))}
    </ol>
  </div>
</section>

<section class="sect adr-redlines">
  <div class="wrap adr-redlines-grid">
    <div class="d-flex flex-column gap-3">
      <p class="eyebrow">{t.redlines.eyebrow}</p>
      <h2 class="h2 adr-h2">{t.redlines.title}</h2>
      <p class="lede">{t.redlines.lede}</p>
    </div>
    <ul class="adr-redline-list">
      {t.redlines.items.map((item) => (
        <li>{item}</li>
      ))}
    </ul>
  </div>
</section>

<section class="sect adr-ladder">
  <div class="wrap d-flex flex-column gap-5">
    <div class="d-flex flex-column gap-3">
      <p class="eyebrow">{t.ladder.eyebrow}</p>
      <h2 class="h2 adr-h2">{t.ladder.title}</h2>
      <p class="lede lede-640">{t.ladder.lede}</p>
    </div>
    <ol class="adr-ladder-steps">
      {t.ladder.levels.map(([code, name, body], i) => (
        <li class={'adr-rung adr-rung-' + (3 - i)}>
          <span class="adr-rung-code">{code}</span>
          <span class="adr-rung-name">{name}</span>
          <span class="adr-rung-body">{body}</span>
        </li>
      ))}
    </ol>
    <blockquote class="adr-ladder-quote">{t.ladder.quote}</blockquote>
  </div>
</section>

<section class="sect adr-press" id="press">
  <div class="wrap adr-press-grid">
    <div class="d-flex flex-column gap-4">
      <div class="d-flex flex-column gap-3">
        <p class="eyebrow">{t.press.eyebrow}</p>
        <h2 class="h2 adr-h2">{t.press.title}</h2>
      </div>
      <dl class="adr-facts">
        {t.press.facts.map(([k, v]) => (
          <div class="adr-fact">
            <dt>{k}</dt>
            <dd>{v}</dd>
          </div>
        ))}
      </dl>
      <p class="adr-contact">
        <strong>{t.press.contact}</strong>
        <a href={'mailto:' + t.press.contactEmail}>{t.press.contactEmail}</a>
      </p>
    </div>
    <aside class="adr-quotes">
      <h3 class="adr-quotes-title">{t.press.quotesTitle}</h3>
      <ul>
        {t.press.quotes.map((q) => (
          <li>“{q}”</li>
        ))}
      </ul>
      <a class="btn btn-primary" {...dl}>
        {t.hero.download}
      </a>
      <span class="adr-quotes-meta">{t.pdf.meta}</span>
    </aside>
  </div>
</section>

<section class="sect adr-adopt">
  <div class="wrap d-flex flex-column gap-5">
    <div class="d-flex flex-column gap-3">
      <p class="eyebrow">{t.adopt.eyebrow}</p>
      <h2 class="h2 adr-h2">{t.adopt.title}</h2>
      <p class="lede lede-640">{t.adopt.lede}</p>
    </div>
    <ol class="grid4 adr-phases">
      {t.adopt.phases.map(([when, title, body]) => (
        <li class="adr-phase">
          <span class="adr-phase-when">{when}</span>
          <h3 class="ptitle">{title}</h3>
          <p class="pbody">{body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<section class="adr-cta">
  <div class="wrap adr-cta-inner">
    <p class="adr-cta-tag">{t.cta.eyebrow}</p>
    <h2 class="adr-cta-title">{t.cta.title}</h2>
    <p class="adr-cta-body">{t.cta.body}</p>
    <a class="btn btn-primary btn-lg" {...dl}>
      {t.cta.download}
    </a>
    <span class="adr-cta-meta">{t.pdf.meta}</span>
    <div class="adr-share">
      <span>{t.cta.shareLabel}</span>
      <a href={share.linkedin} target="_blank" rel="noopener">
        LinkedIn
      </a>
      <a href={share.x} target="_blank" rel="noopener">
        X
      </a>
      <a href={share.facebook} target="_blank" rel="noopener">
        Facebook
      </a>
    </div>
  </div>
</section>
